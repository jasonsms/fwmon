#!/bin/sh /etc/rc.common
# fwmon — inbound (L4) connection monitor (complementary to fn-knock).
START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/fwmon

start_service() {
	[ -x "$PROG" ] || return 1
	procd_open_instance fwmon
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/fwmon
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "fwmon"
}
